################################################################################
# GhostDrop — Environment Variables Reference
# Copy to .env and fill in your values. NEVER commit .env to version control.
################################################################################

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Set to "true" when running behind a reverse proxy (nginx, Railway, Render, etc.)
TRUST_PROXY=false

# ─── Database (MySQL) ─────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=ghostdrop_proto
DB_CONNECTION_LIMIT=20

# Production SSL for MySQL (set as base64-encoded PEM in deployment platform env vars)
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA_CERT=<base64-encoded CA certificate>

# ─── Security Secrets (REQUIRED in production) ────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PBKDF2_ITERATIONS=250000
TOKEN_LOOKUP_SECRET=replace_with_a_high_entropy_secret_min_32_chars
SUB_TOKEN_SECRET_KEY=replace_with_64_hex_or_high_entropy_secret_min_32_chars

# ─── Redis (rate limiting & security store) ────────────────────────────────────
# Options: memory (dev only) | redis (production required)
SECURITY_STORE=memory
REDIS_URL=redis://127.0.0.1:6379
# REDIS_PASSWORD=optional_redis_auth_password

# ─── Google Drive ─────────────────────────────────────────────────────────────
# Path to service account JSON key file (relative to backend/ directory)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service_account.json

# Google Drive folder ID or full folder URL
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# OR use OAuth2 (personal Drive):
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:4000

# ─── Upload Limits ────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_UPLOAD=20
MAX_VAULT_SIZE_MB=250
MAX_TOTAL_SYSTEM_SIZE_MB=14336
BATCH_DOWNLOAD_MAX_FILES=10
UPLOAD_CONCURRENCY=4

# ─── CAPTCHA ──────────────────────────────────────────────────────────────────
# Options: math (built-in) | hcaptcha | recaptcha
CAPTCHA_PROVIDER=math
CAPTCHA_ALLOW_MATH_FALLBACK=true
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ─── IP Risk Lists (optional) ─────────────────────────────────────────────────
# Comma-separated IP addresses for risk scoring
RISK_BAD_IPS=
RISK_TOR_IPS=
RISK_VPN_IPS=

# ─── Advanced Rate Limit Overrides (optional JSON) ────────────────────────────
# Example: {"files.download":{"minute":15,"day":200},"default":{"minute":20,"day":300}}
ROUTE_RATE_LIMITS_JSON=
# Example: {"vault.access":{"captchaThreshold":30,"blockThreshold":85},"default":{"captchaThreshold":45,"blockThreshold":90}}
ROUTE_RISK_POLICY_JSON=

# ─── Portfolio Integrity Background Scan ──────────────────────────────────────
# Set to milliseconds interval (e.g. 300000 = 5 minutes), 0 = disabled
PORTFOLIO_INTEGRITY_SCAN_INTERVAL_MS=0

# Portfolio integrity hash HMAC key — required in production
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PORTFOLIO_INTEGRITY_SECRET=replace_with_a_high_entropy_secret

# ─── Vault Cleanup Service ─────────────────────────────────────────────────────
# How often the cleanup scan runs (milliseconds). Default: 600000 (10 minutes)
VAULT_CLEANUP_INTERVAL_MS=600000
# Hours after vault expiry before purging Drive files and DB records. Default: 1
VAULT_CLEANUP_GRACE_HOURS=1
# Max vaults processed per cleanup cycle. Default: 20
VAULT_CLEANUP_BATCH_SIZE=20

# ─── File Key Wrapping ────────────────────────────────────────────────────────
# PBKDF2 iterations for file key wrapping (separate from token hashing). Default: 200000
FILE_KEY_WRAP_ITERATIONS=200000

# ─── Audit Log ────────────────────────────────────────────────────────────────
# Max entries per active audit.log before rotation into a sealed block file. Default: 1000
AUDIT_LOG_BLOCK_SIZE=1000

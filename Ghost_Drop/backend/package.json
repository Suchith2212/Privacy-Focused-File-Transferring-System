{
    "name": "ghostdrop-backend",
    "version": "1.0.0",
    "description": "GhostDrop — Privacy-focused file transfer vault",
    "main": "src/app.js",
    "scripts": {
        "start": "node src/app.js",
        "start:prod": "cross-env NODE_ENV=production node src/app.js",
        "dev": "nodemon src/app.js",
        "migrate:encrypt-legacy": "node scripts/migrate_legacy_file_encryption.js",
        "build:frontend": "npx esbuild ../frontend/app.js --bundle --minify --outfile=../frontend/app.min.js",
        "lint": "npx eslint src/"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "file-type": "^16.5.4",
        "googleapis": "^142.0.0",
        "helmet": "^8.2.0",
        "jszip": "^3.10.1",
        "lru-cache": "^11.5.1",
        "multer": "^1.4.5-lts.1",
        "mysql2": "^3.11.3",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "qrcode": "^1.5.4",
        "redis": "^4.7.0",
        "uuid": "^10.0.0"
    },
    "devDependencies": {
        "cross-env": "^7.0.3",
        "eslint": "^9.0.0",
        "nodemon": "^3.1.7"
    }
}
